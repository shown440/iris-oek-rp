# Copy to .env and replace every "change-me" value. .env is git-ignored;
# never commit real credentials.

# ---- PostGIS container (docker compose) ------------------------------------
POSTGRES_DB=iris
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
# Schema owner, DDL only - used by Alembic migrations.
IRIS_MIGRATOR_USER=iris_migrator
IRIS_MIGRATOR_PASSWORD=change-me-migrator
# Runtime role: SELECT / INSERT / UPDATE on iris_staging only.
IRIS_DB_USER=iris_harvester
IRIS_DB_PASSWORD=change-me-harvester
# Published on 127.0.0.1 only.
POSTGIS_PORT=5434

# ---- Harvester -------------------------------------------------------------
# Used for runs outside Docker; inside Docker compose builds the URL itself.
IRIS_DATABASE_URL=postgresql+psycopg://iris_harvester:change-me-harvester@localhost:5434/iris
# fixture = offline demonstrator, live = real WFS endpoint
IRIS_SOURCE_MODE=fixture
IRIS_WFS_URL=https://geodaten-wasser.rlp.de/wfs/kompensation
IRIS_WFS_LAYER=rp_oekokonto
IRIS_WFS_VERSION=2.0.0
# Extra hosts (comma-separated) that advertised operation URLs / redirects may
# use besides the endpoint's own domain.
IRIS_WFS_ALLOWED_HOSTS=
# Set to true only after reading the service's AccessConstraints.
IRIS_ACCESS_CONSTRAINTS_ACKNOWLEDGED=false
IRIS_PAGE_SIZE=500
IRIS_MAX_FEATURES=50000
IRIS_MAX_RESPONSE_MB=200
IRIS_REQUEST_DELAY_S=1.0
IRIS_HTTP_TIMEOUT_S=60
IRIS_HTTP_RETRIES=3
